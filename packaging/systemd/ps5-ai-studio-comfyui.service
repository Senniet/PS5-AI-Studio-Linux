[Unit]
Description=PS5 AI Studio ComfyUI Workflow Backend
After=network.target ps5-ai-studio-linux.service
Wants=ps5-ai-studio-linux.service

[Service]
Type=simple
WorkingDirectory=/home/michel/PS5-AI-Studio-Linux/runtimes/ComfyUI
ExecStart=/home/michel/PS5-AI-Studio-Linux/runtimes/comfy-venv/bin/python /home/michel/PS5-AI-Studio-Linux/runtimes/ComfyUI/main.py --cpu --listen 192.168.2.210 --port 8790 --disable-auto-launch --enable-manager --offline --disable-metadata --disable-pinned-memory --extra-model-paths-config /home/michel/PS5-AI-Studio-Linux/runtimes/ComfyUI/extra_model_paths.yaml
Restart=on-failure
RestartSec=5
Environment=PS5_AI_STUDIO_API=http://127.0.0.1:8787
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
